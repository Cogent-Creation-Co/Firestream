## Development Logs
logs/**
*.log

# Temporary files
**/tmp/**

## Local Secrets ##
# Used to provide API keys etc. to the application locally. Contains sensitive data.
.env.secrets

# Created docker-compose file (contains secrets!)
docker/firestream/docker-compose.devcontainer.yml

## Downloaded Software / Plugins ##
submodules/plugins/**

# Mac OS
.DS_Store

# Build Artifacts
**/.next/**

# WIP Hacking
submodules/examples/**
_WIP/**


# Rendered Deployment files
src/deploy/rendered/**
**/.pulumi/**
.env

# firestream-ci run dirs + image/manifest/sbom output. Unanchored on purpose:
# `_build/**` contains a slash, so git pinned it to the repo root and a stray
# `src/util/_build/` (from `cd src/util && cargo run -p firestream-ci ...`)
# slipped through. There should only ever be ONE `_build/`, at the repo root
# (rundir::default_build_root enforces that) — this catches it anywhere.
_build/

# Nix build outputs
result
**/result/**
result-*
.nix-cache/

# Docker-based container build output (apps.<name>-image / firestream-build-image)
.firestream-build/

# Per-checkout runtime state: the TUI's log (src/lib/rust/firestream/src/main.rs)
# and any nix out-links dropped here. Never tracked — a /nix/store symlink is
# dangling on every other machine and re-diffs on every rebuild.
/.firestream/

# Nix/direnv caches
.direnv/
.devenv/
.envrc.local

# Rust target directories at root
target/

# Python eggs
*.egg-info/
.eggs/

# Additional caches
.mypy_cache/
.tox/
.cache/

# Templatizer build-time embedded files (generated by build.rs)
src/lib/rust/templatizer/embedded/**/*

# Template build artifacts and lockfiles
src/templates/**/.turbo/
src/templates/**/.sccache/
src/templates/**/.cargo-nix/
src/templates/**/dist/
